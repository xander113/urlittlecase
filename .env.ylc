# ─── YourLittleCase! Environment Variables ───────────────────────────────────
# Add these to your .env file (merge with existing)

# Admin account
ADMIN_EMAIL=admin@yourlittlecase.com
ADMIN_PASSWORD=changeme123!

# Queue driver — use 'database' (no Redis)
QUEUE_CONNECTION=database

# Cache driver — use 'database' or 'file' (no Redis)
CACHE_DRIVER=file
SESSION_DRIVER=database

# Broadcasting
BROADCAST_CONNECTION=reverb

# Laravel Reverb (generated by: php artisan install:broadcasting --reverb)
REVERB_APP_ID=ylc_app
REVERB_APP_KEY=ylc_key_change_me
REVERB_APP_SECRET=ylc_secret_change_me
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite-exposed Reverb vars (automatically picked up by bootstrap.js)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Required setup commands after merging ───────────────────────────────────
# php artisan migrate
# php artisan db:seed
# php artisan install:broadcasting --reverb   (if not already done)
# php artisan queue:work --queue=default      (in a separate process)
# php artisan reverb:start                   (in a separate process)
# php artisan schedule:work                  (in a separate process)
# php artisan storage:link
